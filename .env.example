[TEMPLATE — copy to .env and fill in. NEVER commit .env.]
# ==========================================
# DATABASE (Prisma / MariaDB)
# ==========================================
# The Jest integration suites run against "<this database>_test", derived from this value.
# See __tests__/support/test-database.ts — do not point them at development data.
DATABASE_URL="mysql://USERNAME:PASSWORD@127.0.0.1:3306/tinggalklik"

# ==========================================
# AUTH (Auth.js / NextAuth v5)
# ==========================================
# REQUIRED. Signs and encrypts the JWT session cookie (~32 bytes of entropy):
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# PRODUCTION: SET THIS, AND SET IT CORRECTLY.
# Auth.js OVERWRITES `req.url` with AUTH_URL (`next-auth/lib/env.js`: "If AUTH_URL is defined,
# override the request's URL"), so the origin used to build `/login?callbackUrl=...` redirects
# comes from here — NOT from the host the request arrived on. A wrong value sends users to the
# wrong host after signing in. Use the deployment's real public origin, with https://.
# (For a single-origin deployment AUTH_URL is the supported answer; AUTH_TRUST_HOST=true is the
# alternative when the origin genuinely varies per request.)
AUTH_URL="http://localhost:3000"

# ==========================================
# GOOGLE OAUTH
# ==========================================
# The redirect URI registered at Google must be <AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"

# ==========================================
# APP ORIGIN (used for payment callback URLs, share links, Open Graph)
# ==========================================
# Must be the public HTTPS origin in production; `lib/payment/config.ts` REFUSES to build a
# payment session when it is missing, when it is not https, or when it names localhost /
# 127.0.0.1 / a sandbox domain. This is a hard requirement, not a hint.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# RUNTIME (the production server)
# ==========================================
# Read by `next start` itself, not by application code. Neither value is a secret, and
# neither belongs in this file — set them in the PROCESS environment (the systemd unit, the
# PM2 config, the shell that starts the app). They are documented here because a missing
# PORT is the difference between the app listening where nginx expects it and not.
#
# PORT — the listening port; `next start -p` takes its default from this variable, so it is
# the single source of truth. `ecosystem.config.cjs` sets it for the PM2 process; keep it in
# step with the reverse proxy's upstream.
#
#   NOTE: `next start` resolves the port BEFORE it loads the .env files, so a PORT line in
#   this file is NOT honoured by the production start command. That is why it is commented:
#   setting it here would look like configuration while doing nothing.
# PORT="3000"
#
# HOSTNAME — not read by `next start` at all, and on most Linux shells it is already set to
# the machine name, so exporting it changes nothing. The bound interface is a CLI flag:
# `next start -H 127.0.0.1`. It lives in `ecosystem.config.cjs`, because the address a
# process binds is a property of the process definition rather than of the environment.
#
# NODE_ENV — set by `next build` and `next start` themselves. Do not set it by hand: a
# `development` value before a build produces a development bundle, and a `production`
# value before `next dev` disables useful local behaviour.

# ==========================================
# iPAYMU (payment gateway) — ACTIVE CONFIGURATION
# ==========================================
# `PAYMENT_ENVIRONMENT` SELECTS THE CREDENTIAL PAIR. It must be exactly "sandbox" or
# "production"; when it is missing or misspelled, payment operations THROW rather than
# silently falling back to sandbox (`lib/payment/config.ts`).
PAYMENT_ENVIRONMENT="sandbox"

# Sandbox pair (used when PAYMENT_ENVIRONMENT=sandbox)
IPAYMU_SANDBOX_VA="replace-me"
IPAYMU_SANDBOX_API_KEY="replace-me"
# Optional. Defaults to https://sandbox.ipaymu.com — only set to point at a stub in tests.
# IPAYMU_SANDBOX_BASE_URL="https://sandbox.ipaymu.com"

# Production pair (used when PAYMENT_ENVIRONMENT=production)
IPAYMU_PRODUCTION_VA="replace-me"
IPAYMU_PRODUCTION_API_KEY="replace-me"
# Optional. Defaults to https://my.ipaymu.com
# IPAYMU_PRODUCTION_BASE_URL="https://my.ipaymu.com"

# NOTE: the payment ROUTES never read a credential from a request, and the webhook's trust
# boundary is the HMAC signature over the raw body (lib/ticketing/payment/webhook.ts), not a
# session. No provider call is made by the test suite.

# Legacy single-environment names. Nothing in `app/` or `lib/` reads these; they are used only
# by the manual operator scripts (`scripts/audit-ipaymu.ts`, `scripts/test-ipaymu-sandbox.js`).
# Do not configure production with them.
# IPAYMU_API_KEY=""
# IPAYMU_VA=""
# IPAYMU_URL=""
# IPAYMU_IS_PRODUCTION="false"

# ==========================================
# UPLOADS (event imagery)
# ==========================================
# Processed images are written to <UPLOAD_DIR>/events and served from /api/uploads/events/...
# Defaults to ./storage/uploads when unset. On a VPS this directory MUST be persistent and
# MUST be backed up: image rows in the database point at files that only exist here.
UPLOAD_DIR="./storage/uploads"

# ==========================================
# RATE LIMITING / PROXY
# ==========================================
# Behind a reverse proxy this MUST be set to the proxy's address, or `getClientIp()` returns
# the sentinel "untrusted" and EVERY client shares a single rate-limit bucket
# (`lib/rate-limit.ts`). That makes the login bucket (5 attempts / 15 min) a platform-wide
# throttle that one attacker can exhaust, locking everyone out. See the deployment checklist.
TRUSTED_PROXY=""

# Declared but NOT used: the limiter is in-memory and per-process (single VPS = fine;
# multi-instance = one bucket per instance). Setting this only logs a warning today.
REDIS_URL=""

# ==========================================
# SCHEDULER (event lifecycle + reservation reaper)
# ==========================================
# Shared secret for POST /api/internal/jobs/tick. The route is machine-authenticated: it has
# no session gate (its caller is cron), it compares the presented bearer token in CONSTANT
# TIME, and it FAILS CLOSED (401) when this is unset — so an unconfigured deployment never
# exposes an unauthenticated "run every job" endpoint. Generate with: openssl rand -hex 32
JOBS_TICK_SECRET="replace-with-a-random-secret"

# The tick is driven by the deployment's clock, one request per minute:
#
#   * * * * * curl -fsS -X POST https://YOUR_HOST/api/internal/jobs/tick \
#     -H "Authorization: Bearer $JOBS_TICK_SECRET" >/dev/null
#
# No worker process, no Redis, no BullMQ, no queue: the tick is idempotent, and overlapping
# runs are serialized by a database lease (table `joblock`). It is REQUIRED — it performs
# PUBLISHED→ONGOING→COMPLETED transitions and releases expired seat holds. Without it an
# event never completes and abandoned carts keep their inventory indefinitely.
#
# See README.md and PHASE_15_EVENT_AUTOMATION_IMPLEMENTATION_REPORT.md.
