# ==========================================
# TESTING
# ==========================================
SPIN_WHEEL_TEST_MODE="false"

# ==========================================
# SCHEDULER (Phase 15 — event lifecycle + reservation reaper)
# ==========================================
# Shared secret for POST /api/internal/jobs/tick. The route is machine-authenticated:
# it has no session gate (the caller is cron), and it fails CLOSED (401) when this is
# unset, so an unconfigured deployment never exposes an unauthenticated "run every job"
# endpoint. Generate one with: openssl rand -hex 32
JOBS_TICK_SECRET="replace-with-a-random-secret"

# The tick itself is driven by the deployment's cron, one request per minute:
#
#   * * * * * curl -fsS -X POST https://YOUR_HOST/api/internal/jobs/tick \
#     -H "Authorization: Bearer $JOBS_TICK_SECRET" >/dev/null
#
# No worker process, no Redis, no BullMQ: the tick is idempotent, and overlapping runs
# are serialized by a DB lease (table `joblock`). See PHASE_15_EVENT_AUTOMATION_IMPLEMENTATION_REPORT.md.