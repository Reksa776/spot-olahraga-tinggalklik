generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// EXISTING MODELS (UNCHANGED except relations)
// ==========================================

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  phone         String?        @unique
  password      String?
  image         String?
  role          Role           @default(CUSTOMER)
  referralCode  String?        @unique
  referredBy    String?
  emailVerified DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  cart          Cart?
  orders        Order[]
  sessions      Session[]
  addresses     UserAddress[]
  notifications Notification[]

  // Marketing & Affiliate relations
  affiliateProfile   AffiliateProfile?
  flashSalePurchases FlashSalePurchase[]
  voucherUsages      VoucherUserUsage[]

  // Spin Wheel relations
  spinWheelSpins SpinWheelSpin[]

  // ==========================================
  // TICKETING FOUNDATION RELATIONS (additive)
  // ==========================================
  //
  // Phase 2 — additive database foundation for the Event & Sports
  // Ticketing domain. Nothing here is read or written by the existing
  // retail application yet. `platformRole` is intentionally NULLABLE so
  // no data is backfilled and the legacy `role` column keeps its exact
  // current semantics; Phase 3 owns the population/backfill.

  platformRole PlatformRole?

  ownedOrganizers        Organizer[]            @relation("OrganizerOwner")
  organizerMemberships   OrganizerMember[]      @relation("OrganizerMemberUser")
  invitationsSent        OrganizerMember[]      @relation("OrganizerMemberInvitedBy")
  membershipsRevoked     OrganizerMember[]      @relation("OrganizerMemberRevokedBy")
  staffAssignmentsMade   StaffEventAssignment[] @relation("StaffAssignedBy")
  permissionGrants       PermissionGrant[]      @relation("PermissionGrantUser")
  permissionGrantsGiven  PermissionGrant[]      @relation("PermissionGrantGrantedBy")
  permissionGrantsRevoked PermissionGrant[]     @relation("PermissionGrantRevokedBy")
  eventsCreated          Event[]                @relation("EventCreatedBy")
  ticketOrders           EventOrder[]           @relation("EventOrderBuyer")
  ticketsHeld            Ticket[]               @relation("TicketHolder")
  checkInsPerformed      CheckIn[]              @relation("CheckInStaff")
  paymentsCreated        Payment[]              @relation("PaymentCreatedBy")
  picProfile             PICProfile?            @relation("PICProfileUser")
  picProfilesApproved    PICProfile[]           @relation("PICProfileApprovedBy")
  picAssignmentsMade     PICEventAssignment[]   @relation("PICAssignmentAssignedBy")
  attributionsOverridden PICAttribution[]       @relation("PICAttributionOverriddenBy")
  feeEntriesCreated      PICFeeLedger[]         @relation("PICFeeEntryCreatedBy")
  settlementsPrepared    Settlement[]           @relation("SettlementPreparedBy")
  settlementsApproved    Settlement[]           @relation("SettlementApprovedBy")
  settlementsPaid        Settlement[]           @relation("SettlementPaidBy")
  idempotencyKeys        IdempotencyKey[]
  auditLogs              AdminAuditLog[]        @relation("AuditLogActor")

  @@map("user")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
  @@map("account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtoken")
}

model Product {
  id          Int              @id @default(autoincrement())
  name        String
  slug        String           @unique
  description String?          @db.Text
  sold        Int              @default(0)
  rating      Float            @default(0)
  image       String?          @db.Text
  category    String?
  bestseller  Boolean          @default(false)
  isArchived  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  cartItems   CartItem[]
  orderItems  OrderItem[]
  variants    ProductVariant[]

  // Marketing relations
  discounts        ProductDiscount[]
  flashSales       FlashSale[]
  bulkDiscounts    BulkDiscount[]
  campaignProducts CampaignProduct[]
  voucherProducts  VoucherProduct[]
  affiliateClicks  AffiliateClick[]

  @@index([isArchived])
  @@map("product")
}

model ProductVariant {
  id         Int         @id @default(autoincrement())
  name       String
  price      Decimal     @db.Decimal(12, 2)
  stock      Int         @default(0)
  productId  Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  image      String?     @db.Text
  weight     Int         @default(100)
  cartItems  CartItem[]
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Marketing relations
  discounts      ProductDiscount[]
  flashSales     FlashSale[]
  bulkDiscounts  BulkDiscount[]

  @@index([productId])
  @@map("productvariant")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  @@map("cart")
}

model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int
  productId Int
  variantId Int
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([productId])
  @@index([variantId])
  @@map("cartitem")
}

model UserAddress {
  id                      String    @id @default(cuid())
  userId                  String
  label                   String?
  recipientName           String
  phone                   String
  address                 String    @db.Text
  province                String?
  city                    String?
  district                String?
  subdistrict             String?
  postalCode              String?
  rajaOngkirDestinationId Int?
  latitude                Decimal?  @db.Decimal(10, 7)
  longitude               Decimal?  @db.Decimal(10, 7)
  isDefault               Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  districtId              Int?
  provinceId              Int?
  regencyId               Int?
  villageId               Int?
  districtRef             District? @relation(fields: [districtId], references: [id])
  provinceRef             Province? @relation(fields: [provinceId], references: [id])
  regencyRef              Regency?  @relation(fields: [regencyId], references: [id])
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  villageRef              Village?  @relation(fields: [villageId], references: [id])

  @@index([userId])
  @@index([provinceId])
  @@index([regencyId])
  @@index([districtId])
  @@index([villageId])
  @@index([rajaOngkirDestinationId])
  @@map("useraddress")
}

model Order {
  id               Int                 @id @default(autoincrement())
  userId           String
  orderNumber      String              @unique
  recipientName    String
  phone            String
  address          String              @db.Text
  note             String?             @db.Text
  subtotal         Decimal             @db.Decimal(12, 2)
  shippingCost     Decimal             @db.Decimal(12, 2)
  total            Decimal             @db.Decimal(12, 2)
  status           Order_status        @default(PENDING)
  paymentMethod    Order_paymentMethod @default(COD)
  paymentStatus    Order_paymentStatus @default(UNPAID)
  paidAt           DateTime?
  shippingCourier  String?
  shippingService  String?
  trackingNumber   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  city             String?
  district         String?
  latitude         Decimal?            @db.Decimal(10, 7)
  longitude        Decimal?            @db.Decimal(10, 7)
  postalCode       String?
  province         String?
  paymentReference String?
  voucherId        Int?
  voucherCode      String?
  discount         Decimal             @default(0) @db.Decimal(12, 2)
  voucher          Voucher?            @relation(fields: [voucherId], references: [id])

  // Shipping discount attribution (F9): which ongkir promo was applied.
  shippingDiscountId Int?
  shippingDiscount   ShippingDiscount? @relation(fields: [shippingDiscountId], references: [id], onDelete: SetNull)
  shippingDiscountName String?
  shippingDiscountAmount Decimal? @db.Decimal(12, 2)

  trackingUrl      String?
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            OrderItem[]
  notifications    Notification[]

  // Affiliate relation (optional)
  affiliateConversion AffiliateConversion?

  // Spin Wheel relation (optional)
  spinWheelSpin SpinWheelSpin?

  // F18: persistence of the EXACT spin consumed at checkout.
  // Unlike spinWheelSpin.orderId (which is cleared when the spin is
  // released on cancel), this keeps the identity so repayment can
  // re-reserve the same spin instead of grabbing a different one.
  originalSpinWheelSpinId Int?
  originalSpinWheelSpin   SpinWheelSpin? @relation("OrderOriginalSpin", fields: [originalSpinWheelSpinId], references: [id], onDelete: SetNull)

  // Refund relation (optional)
  refund Refund?

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([trackingNumber])
  @@map("order")
}

model OrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int
  productId   Int?
  variantId   Int?
  productName String
  variantName String
  price       Decimal         @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal         @db.Decimal(12, 2)
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("orderitem")
}

model StoreSetting {
  id        Int     @id @default(1)
  storeName String
  logo      String? @db.Text
  email     String?
  phone     String?
  address   String  @db.Text

  // TikTok Pixel
  tiktokPixelId String?

  province                String?
  city                    String?
  district                String?
  subdistrict             String?
  postalCode              String?
  rajaOngkirDestinationId Int?
  latitude                Decimal? @db.Decimal(10, 7)
  longitude               Decimal? @db.Decimal(10, 7)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  cityId                  Int?
  districtId              Int?
  provinceId              Int?
  subdistrictId           Int?
  @@map("storesetting")
}

model Province {
  id        Int           @id
  name      String
  regencies Regency[]
  addresses UserAddress[]

  @@index([name])
  @@map("province")
}

model Regency {
  id         Int           @id
  provinceId Int
  name       String
  districts  District[]
  province   Province      @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  addresses  UserAddress[]

  @@index([provinceId])
  @@index([name])
  @@map("regency")
}

model District {
  id        Int           @id
  regencyId Int
  name      String
  regency   Regency       @relation(fields: [regencyId], references: [id], onDelete: Cascade)
  addresses UserAddress[]
  villages  Village[]

  @@index([regencyId])
  @@index([name])
  @@map("district")
}

model Village {
  id         Int           @id
  districtId Int
  name       String
  postalCode String?
  addresses  UserAddress[]
  district   District      @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@index([districtId])
  @@index([name])
  @@index([postalCode])
  @@map("village")
}

model RajaOngkirRegion {
  id            Int      @id @default(autoincrement())
  destinationId Int      @unique
  provinceId    Int?
  province      String?
  cityId        Int?
  city          String?
  districtId    Int?
  district      String?
  subdistrictId Int?
  subdistrict   String?
  postalCode    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@map("rajaongkirregion")
}

model Voucher {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  description String?
  type        Voucher_type
  value       Decimal      @db.Decimal(12, 2)

  /**
   * Cap nominal maksimal diskon, khusus tipe PERCENTAGE.
   * Contoh: diskon 20% tapi maksimal Rp 50.000.
   * Diabaikan kalau type = FIXED.
   */
  maxDiscount Decimal? @db.Decimal(12, 2)

  /**
   * Minimal subtotal belanja supaya voucher bisa dipakai.
   * null = tidak ada minimal.
   */
  minPurchase Decimal? @db.Decimal(12, 2)

  /**
   * Kuota total pemakaian voucher ini (semua user).
   * null = tidak terbatas.
   */
  quota     Int?
  usedCount Int  @default(0)

  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  // Marketing & Voucher extension relations
  campaignId           Int?
  campaign             Campaign?          @relation(fields: [campaignId], references: [id])
  maxUsagePerUser      Int?
  eligibility          VoucherEligibility @default(ALL)
  productRestrictions  VoucherProduct[]
  categoryRestrictions VoucherCategory[]
  userUsages           VoucherUserUsage[]

  @@index([isActive])
  @@map("voucher")
}

// ==========================================
// EXISTING ENUMS (UNCHANGED)
// ==========================================

enum Voucher_type {
  PERCENTAGE
  FIXED
}

enum VoucherEligibility {
  ALL
  NEW_USER
  RETURNING_USER
}

enum Role {
  ADMIN
  SELLER
  CUSTOMER
  AFFILIATOR
}

enum Order_status {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUND_PENDING
}

enum Order_paymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum Order_paymentMethod {
  COD
  BANK_TRANSFER
  E_WALLET
  QRIS
}

enum Notification_status {
  QUEUED
  PROCESSING
  SENT
  FAILED
}

model Notification {
  id                Int                 @id @default(autoincrement())
  orderId           Int?
  userId            String?
  channel           String
  notificationType  String
  recipient         String
  idempotencyKey    String              @unique
  providerMessageId String?
  payload           String?             @db.Text
  status            Notification_status @default(QUEUED)
  errorCode         String?
  errorMessage      String?             @db.Text
  retryCount        Int                 @default(0)
  maxRetries        Int                 @default(3)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  // ==========================================
  // TICKETING FOUNDATION (additive, nullable)
  // ==========================================
  //
  // Event & Sports Ticketing notifications (e-ticket delivery, payment
  // events, PIC fee events). All columns are nullable so the existing
  // retail notification writer keeps working unchanged. `orderId` keeps
  // its retail meaning (Order); `eventOrderId` is the ticketing order.

  eventOrderId  String?
  ticketId      String?
  eventId       String?
  organizerId   String?
  picProfileId  String?
  recipientType NotificationRecipientType?
  category      NotificationCategory?
  templateKey   String?
  priority      Int?

  eventOrder EventOrder? @relation(fields: [eventOrderId], references: [id], onDelete: SetNull)
  ticket     Ticket?     @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  event      Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  organizer  Organizer?  @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  picProfile PICProfile? @relation(fields: [picProfileId], references: [id], onDelete: SetNull)

  deliveries NotificationDelivery[]

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([channel])
  @@index([notificationType])
  @@index([eventOrderId])
  @@index([ticketId])
  @@index([organizerId])
  @@map("notification")
}

// ==========================================
// MARKETING CORE — NEW MODELS
// ==========================================

// ------------------------------------------
// 2.1 CAMPAIGN
// ------------------------------------------

model Campaign {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String? @db.Text
  bannerUrl   String? @db.Text
  code        String? @unique

  type   CampaignType   @default(GENERAL)
  status CampaignStatus @default(DRAFT)

  startAt DateTime
  endAt   DateTime

  // Campaign-wide discount configuration
  discountType  Voucher_type?
  discountValue Decimal?      @db.Decimal(12, 2)
  maxDiscount   Decimal?      @db.Decimal(12, 2)

  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   CampaignProduct[]
  categories CampaignCategory[]
  vouchers   Voucher[]

  @@index([status])
  @@index([startAt, endAt])
  @@map("campaign")
}

model CampaignProduct {
  id         Int      @id @default(autoincrement())
  campaignId Int
  productId  Int
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([campaignId])
  @@index([productId])
  @@map("campaignproduct")
}

model CampaignCategory {
  id         Int      @id @default(autoincrement())
  campaignId Int
  category   String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, category])
  @@index([campaignId])
  @@map("campaigncategory")
}

enum CampaignType {
  GENERAL
  FLASH_SALE
  CATEGORY_DISCOUNT
  PRODUCT_DISCOUNT
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

// ------------------------------------------
// 3. PRODUCT DISCOUNT
// ------------------------------------------

model ProductDiscount {
  id        Int  @id @default(autoincrement())
  productId Int
  variantId Int?

  type        Voucher_type
  value       Decimal      @db.Decimal(12, 2)
  maxDiscount Decimal?     @db.Decimal(12, 2)

  startAt  DateTime
  endAt    DateTime
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([isActive, startAt, endAt])
  @@map("productdiscount")
}

// ------------------------------------------
// 4. FLASH SALE
// ------------------------------------------

model FlashSale {
  id        Int    @id @default(autoincrement())
  name      String
  productId Int
  variantId Int

  salePrice     Decimal @db.Decimal(12, 2)
  saleStock     Int
  soldCount     Int     @default(0)
  purchaseLimit Int?    @default(1)

  startAt  DateTime
  endAt    DateTime
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  purchases FlashSalePurchase[]

  @@unique([variantId])
  @@index([isActive, startAt, endAt])
  @@index([variantId])
  @@map("flashsale")
}

model FlashSalePurchase {
  id          Int    @id @default(autoincrement())
  flashSaleId Int
  userId      String
  quantity    Int

  createdAt DateTime @default(now())

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([flashSaleId, userId])
  @@index([flashSaleId])
  @@index([userId])
  @@map("flashsalepurchase")
}

// ------------------------------------------
// 6. PROMOTION / BANNER
// ------------------------------------------

model Promotion {
  id        Int                @id @default(autoincrement())
  title     String
  imageUrl  String             @db.Text
  link      String?            @db.Text
  placement PromotionPlacement @default(HOMEPAGE)

  priority Int     @default(0)
  isActive Boolean @default(true)

  startAt DateTime?
  endAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, isActive])
  @@index([startAt, endAt])
  @@map("promotion")
}

enum PromotionPlacement {
  HOMEPAGE
  CAMPAIGN
  CATEGORY
  PRODUCT
}

// ==========================================
// VOUCHER EXTENSIONS — NEW MODELS
// ------------------------------------------
// 7.1 VOUCHER PRODUCT
// ------------------------------------------

model VoucherProduct {
  id        Int     @id @default(autoincrement())
  voucherId Int
  productId Int
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([voucherId, productId])
  @@index([voucherId])
  @@index([productId])
  @@map("voucherproduct")
}

// ------------------------------------------
// 7.2 VOUCHER CATEGORY
// ------------------------------------------

model VoucherCategory {
  id        Int     @id @default(autoincrement())
  voucherId Int
  category  String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([voucherId, category])
  @@index([voucherId])
  @@map("vouchercategory")
}

// ------------------------------------------
// 7.3 VOUCHER USER USAGE
// ------------------------------------------

model VoucherUserUsage {
  id         Int    @id @default(autoincrement())
  voucherId  Int
  userId     String
  usageCount Int    @default(1)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([voucherId, userId])
  @@index([voucherId])
  @@index([userId])
  @@map("voucheruserusage")
}

// ==========================================
// BULK DISCOUNT (BELI BANYAK LEBIH HEMAT)
// ==========================================

model BulkDiscount {
  id        Int    @id @default(autoincrement())
  name      String
  productId Int
  variantId Int?

  minQuantity Int
  type        Voucher_type
  value       Decimal @db.Decimal(12, 2)
  maxDiscount Decimal? @db.Decimal(12, 2)

  startAt  DateTime
  endAt    DateTime
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([isActive, startAt, endAt])
  @@map("bulkdiscount")
}

// ==========================================
// SHIPPING DISCOUNT (DISKON ONGKIR)
// ==========================================

model ShippingDiscount {
  id             Int     @id @default(autoincrement())
  name           String
  code           String? @unique

  type           Voucher_type
  value          Decimal @db.Decimal(12, 2)
  maxDiscount    Decimal? @db.Decimal(12, 2)
  minPurchase    Decimal? @db.Decimal(12, 2)

  /**
   * Kuota total pemakaian diskon ongkir (semua user).
   * null = tidak terbatas.
   */
  quota Int?
  usedCount Int @default(0)
  maxUsagePerUser Int?

  startAt  DateTime
  endAt    DateTime
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([isActive, startAt, endAt])
  @@index([code])
  @@map("shippingdiscount")
}

// ==========================================
